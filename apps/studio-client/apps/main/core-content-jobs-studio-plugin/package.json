{
  "name": "@coremedia-blueprint/studio-client.main.core-content-jobs-studio-plugin",
  "author": "Black App Solutions",
  "version": "1.0.0-SNAPSHOT",
  "private": true,
  "dependencies": {
    "@jangaroo/ext-ts": "^2.1.0",
    "@jangaroo/runtime": "^3.3.1",
    "@coremedia-blueprint/studio-client.main.blueprint-forms": "workspace:*",
    "@coremedia/studio-client.cap-base-models": "2506.0.3",
    "@coremedia/studio-client.cap-rest-client": "2506.0.3",
    "@coremedia/studio-client.ext.errors-validation-components": "2506.0.3",
    "@coremedia/studio-client.main.editor-components": "2506.0.3",
    "@coremedia/studio-client.ext.ui-components": "2506.0.3"
  },
  "devDependencies": {
    "@jangaroo/build": "^3.3.1",
    "@jangaroo/core": "^3.3.1",
    "@jangaroo/joounit": "^3.3.1",
    "@coremedia/sencha-ext": "^1.1.0",
    "@coremedia/sencha-ext-classic": "^1.1.0",
    "@coremedia/sencha-ext-classic-locale": "^1.1.0",
    "@coremedia/eslint-config-studio-client-ext": "2506.0.3",
    "eslint": "^8.57.0",
    "rimraf": "^5.0.7"
  },
  "scripts": {
    "clean": "rimraf ./dist && rimraf ./build",
    "build": "jangaroo build",
    "watch": "jangaroo watch",
    "test": "jangaroo joounit",
    "lint": "eslint \"src/**/*.ts\" \"joounit/**/*.ts\""
  },
  "exports": {
    "./*": {
      "types": "./src/*.ts",
      "default": "./dist/src/*.js"
    }
  },
  "coremedia": {
    "projectExtensionFor": "studio-client.main"
  },
  "publishConfig": {
    "directory": "dist",
    "exports": {
      "./*": {
        "types": "./src/*.d.ts",
        "default": "./src/*.js"
      }
    }
  }
}
